# Copy this file to .env and fill in your API key.
# Get your Qwen API key from: https://dashscope.aliyun.com/

QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MinIO credentials [deepstream only] — self-hosted (the `minio` compose service),
# so these are NOT fetched from anywhere; pick any values, they just have to match
# between the minio service and the iris/deepstream-sidecar containers reading them.
# Min length: 3 chars for the access key, 8 for the secret key. Defaults to
# minioadmin/minioadmin if unset — fine for local testing, change before exposing MinIO.
MINIO_ACCESS_KEY=iris-minio
MINIO_SECRET_KEY=change-me-to-a-real-secret

# LAN RTSP camera credentials for cam-1/2/3 (real cameras, see go2rtc.yaml's
# raw-cam-1/2/3). go2rtc substitutes ${RTSP_USER}/${RTSP_PASS} in go2rtc.yaml
# itself, natively (docs: https://github.com/AlexxIT/go2rtc/wiki/Configuration);
# docker-compose.yml's go2rtc service passes these two vars into that container.
# Unset => cam-1/2/3 fail to authenticate (visible in go2rtc's own log).
# Never commit real credentials — keep them in .env only.
RTSP_USER=viewer
# NOTE: values are substituted VERBATIM into the rtsp:// URI, so if the real
# password contains special characters (e.g. #@#), provide the URL-encoded form
# (e.g. a password `P@ss#2026` becomes P%40ss%232026). Plain alphanumeric
# passwords can be used as-is.
RTSP_PASS=change-me-to-the-real-password

# Where go2rtc takes raw-cam-1/2/3 from. Leave these unset in the checkout that
# pulls the real cameras: docker-compose.yml then builds the camera addresses
# from RTSP_USER/RTSP_PASS above. In ANY OTHER checkout on the same host, set
# them to the first checkout's go2rtc (its GO2RTC_RTSP_PORT) so the camera
# tunnel still carries each camera once, e.g.:
# RAW_CAM_1_SRC=rtsp://host.docker.internal:18564/raw-cam-1#transport=tcp
# RAW_CAM_2_SRC=rtsp://host.docker.internal:18564/raw-cam-2#transport=tcp
# RAW_CAM_3_SRC=rtsp://host.docker.internal:18564/raw-cam-3#transport=tcp

# ── Multi-developer isolation (2026-09-10) ──────────────────────────────────
# This repo may be checked out more than once on the same machine (different
# developers, or you testing two branches at once). docker-compose.yml's
# project name and every host port default to fixed values that work fine for
# ONE checkout, but two checkouts running those same defaults at once will
# collide -- whichever starts second either fails to bind, or (worse, for
# redis/go2rtc) silently talks to the OTHER checkout's containers instead of
# its own. If you're the only one running this repo on this machine, you can
# leave everything below commented out. If not, uncomment the block and pick
# values that don't collide with any other checkout's .env on this host --
# there's no registry of who's using what, so coordinate with whoever else is
# on the machine (or just pick a distinctive block, e.g. everyone offsets by
# a different +10000).
#
# # Which products this installation runs and shows: a comma-separated list, or
# unset for "everything this checkout has". One value describes the whole
# install -- the dashboard asks the app for it (GET /api/products) and shows
# those products' screens. It is a convenience for the menu, not access
# control: every request is authorised on its own.
#   IRIS_PRODUCT=attendance                        one product
#   IRIS_PRODUCT=attendance,barber                 multiple products
#   IRIS_PRODUCT=concealment_detection             concealment review only
IRIS_PRODUCT=
COMPOSE_PROJECT_NAME=<your-name-or-initials>  # prefixes every container/network/volume;
#                                                 # also whatever `just down`/`clean` scope to,
#                                                 # so two checkouts sharing a name/default
#                                                 # can tear down each other's containers.
# IRIS_HOST_PORT=18000
# REDIS_HOST_PORT=6379
# GO2RTC_RTSP_PORT=8554
# GO2RTC_API_PORT=1984
# GO2RTC_WEBRTC_PORT=8555
# MINIO_API_HOST_PORT=19000
# MINIO_CONSOLE_HOST_PORT=19001
# SIDECAR_TELEMETRY_PORT=9101
# SIDECAR_ATTENDANCE_TELEMETRY_PORT=9102
# SIDECAR_BARBER_TELEMETRY_PORT=9103
# products/attendance and its frontend dev server are host processes (not in
# compose) -- justfile and frontend/vite.config.ts read these two directly.
# ATTENDANCE_BACKEND_PORT=8001
# ATTENDANCE_FRONTEND_PORT=5180
# products/barber is a host process too (`just barber-up`).
# BARBER_BACKEND_PORT=8003
# BARBER_FRONTEND_PORT=5190   # the Barber Ops dashboard (frontend submodule on feat/barber-ops)
# products/fall_detection is a host process (`just fall-up`); its sidecar is the compose
# service deepstream-sidecar-fall under the `fall` profile. The dashboard's dev server proxies
# /fall_detection/api to FALL_BACKEND_PORT.
# FALL_BACKEND_PORT=8004
# SIDECAR_FALL_TELEMETRY_PORT=9105
# products/concealment_detection is a host process (`just concealment-up`); its sidecar is
# the compose service deepstream-sidecar-concealment under the `concealment` profile.
# The dashboard's dev server proxies /concealment_detection/api to CONCEALMENT_BACKEND_PORT.
# CONCEALMENT_BACKEND_PORT=8005
# SIDECAR_CONCEALMENT_TELEMETRY_PORT=9107
# CONCEALMENT_SIDECAR_CONFIG=products/concealment_detection/sidecar.yaml
# CONCEALMENT_CONFIG=products/concealment_detection/concealment_detection.yaml
# Monitoring stack (prometheus/grafana/dcgm-exporter/node-exporter) -- NOT
# started by `just up`/`up-roles`, bring up manually if you need it. dcgm and
# node exporters watch the shared host/GPU, not per-checkout state, so if
# someone else's copy is already running, read theirs instead of starting
# your own duplicate.
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# DCGM_EXPORTER_PORT=9400
# NODE_EXPORTER_PORT=9100

# ── PPE demo (`just ppe-check | ppe-build | ppe-live-sim`, perception/modules/ppe/README.md) ─────────────────────
# Its own compose project and host ports, beside the stack above; every value below is the default, so leave them
# commented out unless one collides with something else on this machine (e.g. a second user's PPE demo: give it
# another project name, ports and data dir). The containers run as whoever runs the recipe (PPE_UID/PPE_GID, set
# by the recipes from `id`, not here). The demo needs no WebRTC settings: its video is the app's JPEG preview.
# PPE_COMPOSE_PROJECT=ppelive
# PPE_SIDECAR_IMAGE=ppelive-deepstream-sidecar:latest   # default <PPE_COMPOSE_PROJECT>-deepstream-sidecar:latest,
#                                                       # built by `just ppe-build` (or any sidecar image built
#                                                       # from this repo's perception/pipeline/Dockerfile)
# PPE_LIVE_DIR=scratch/ppe-live                         # its data, streamer log and pid
# PPE_LIVE_VIDEOS=data/uploads/ppe
# PPE_IRIS_PORT=48000                                   # the dashboard and the MJPEG stream
# PPE_REDIS_PORT=46379
# PPE_GO2RTC_RTSP_PORT=48554                            # the simulated camera is pushed here
# PPE_GO2RTC_API_PORT=41984
# PPE_MINIO_API_PORT=49000
# PPE_MINIO_CONSOLE_PORT=49001
# PPE_SIDECAR_TELEMETRY_PORT=49101

# ── Safety stack (`just safety-*`, products/safety/README.md) ─────────────────────────────────────────────────────
# Its own compose project and host ports, beside the stacks above; every value below is the default. The containers
# run as whoever runs the recipe (SAFETY_UID/SAFETY_GID, set by the recipes from `id`).
# SAFETY_COMPOSE_PROJECT=safety
# SAFETY_SIDECAR_IMAGE=safety-deepstream-sidecar:latest  # `just safety-build`, or any image built from
#                                                        # perception/pipeline/Dockerfile (the code is mounted)
# SAFETY_DIR=scratch/safety                              # its data (mounted at data/), logs and pids
# SAFETY_CAMERAS=products/safety/cameras.yaml
# SAFETY_DEMO_CLIPS=/data/IRIS/data/safety-demo          # the demo cameras' `clip:` files
# SAFETY_MODELS_DIR=perception/models                    # the models the role sidecars load
# SAFETY_IRIS_PORT=58000
# SAFETY_REDIS_PORT=56379
# SAFETY_GO2RTC_RTSP_PORT=58554                          # the demo clips are pushed here
# SAFETY_GO2RTC_API_PORT=51984
# SAFETY_GO2RTC_WEBRTC_PORT=58555
# SAFETY_MINIO_API_PORT=59000
# SAFETY_MINIO_CONSOLE_PORT=59001
# SAFETY_FALL_PORT=58014                                 # the fall service (its review queue)
# The safety stack's Telegram bot (BotFather); the chat it writes to is set in the safety UI's Settings.
# TELEGRAM_BOT_TOKEN=
