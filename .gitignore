node_modules/
frontend/dist/
frontend/.eslintcache
frontend/*.tsbuildinfo

# Generated TRT engine files
*.engine
*.engine.*

# ONNX runtime data files
*.onnx.data

# Runtime benchmark/analysis logs
data/benchmark_sidecar_*.log
data/analysis_calls/
data/description_calls/

# Extra repo docs
EMBEDDING_SEARCH_PLAN.md

# docs
docs/
# ...except the fall product's own docs, which are tracked (its design, its
# requirements, its phase reports and its provenance note). The rule above is
# for scratch directories; these are deliverables.
!products/fall_detection/docs/
!products/concealment_detection/docs/

# Subagent-driven-development scratch workspaces (ledgers, briefs, review packages)
.superpowers/

# Media
*.jpg
*.jpeg
*.webp

# Models
*.pt
*.onnx
# ...except the barber staff classifier (project A), versioned in git on purpose
*.pth
# Barber staff CLIP tokenizer (`just barber-staff-model`, checksummed in perception/pipeline/models.staff.sha256)
perception/models/staff/tokenizer.json

# INT8 calibration inputs (committed so a fresh clone can build the INT8 engine
# without re-running gen_int8_calib_table.py, which needs a source video)
!perception/models/DeepStream-Yolo/calib_images/
!perception/models/DeepStream-Yolo/calib_images/*.jpg

# Fire/smoke detector artifacts -- needed by the sidecar container from the
# workspace mount, same as perception/models/DeepStream-Yolo/damoyolo_s.onnx being tracked.
!perception/models/DeepStream-Yolo-Fire/labels.txt

# Pose detector's class list: the config's labelfile-path points at it, so a fresh clone without it cannot load the
# GIE (the root `labels.txt` rule would hide it). Same reason as the fire model's. The PPE, pose and fall-detection
# weights, graphs and sample clips are DVC pointers (DATA.md), not files git tracks.
!perception/models/DeepStream-Yolo-Pose/labels.txt

benchmarks/fixtures/
data/datasets/CHIRLA0/annotations
data/datasets/
perception/models/DeepStream-Yolo/**
# DVC pointers for the weights that stay out of git (see DATA.md); `**` + `!**/` is the form dvc's own index understands
!perception/models/DeepStream-Yolo/**/
!perception/models/DeepStream-Yolo/**/*.dvc
# ...and the MLflow sidecars (<model>.mlflow.json: run, sha256, registered version; mtmc/tracking, spike D9), which are
# versioned next to the .dvc pointers of the models they describe (yolo11x.onnx, labels.txt)
!perception/models/DeepStream-Yolo/**/*.mlflow.json
# ...and the vendored upstream code (VENDORED.md): its MIT licence, which covers the parser in
# nvdsinfer_custom_impl_Yolo/ too, the provenance note, and the ONNX exporter mtmc/export_vehicle_onnx.py wraps.
!perception/models/DeepStream-Yolo/LICENSE.md
!perception/models/DeepStream-Yolo/VENDORED.md
!perception/models/DeepStream-Yolo/utils/export_yolo11.py
# ...except the vehicle detector the multi-camera pipeline runs on (force-added, like the
# other DeepStream-Yolo models already tracked): config, ONNX, weights, labels.
!perception/models/DeepStream-Yolo/config_infer_primary_vehicle_1cls.txt
# ...and the licence-plate detector run as a secondary GIE on vehicle crops (640 export of
# products/el-mohandes/models/finetuned/best.pt; the weights stay where they are).
!perception/models/DeepStream-Yolo/config_sgie_plate.txt

# TensorRT engine binaries (engine-files/): GPU/TRT-version/batch-specific, not
# portable artifacts — never commit them; rebuilt from the committed ONNX +
# calib.table on first boot.
engine-files/

# Benchmark harness runtime artifact (backup of sidecar.yaml it rewrites per cell)
benchmarks/results/_sidecar.yaml.bak

# MTMC pipeline runtime artifacts (embedding caches, predictions, eval outputs)
mtmc/output/


