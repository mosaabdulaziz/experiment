env/

# Built frontend (generated from submodule)
static/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# claude
CLAUDE.md

# Model weights (downloaded, not source)
*.pt

# InsightFace ONNX weights (downloaded, not source — baked into the image at
# build time by the Dockerfile; the local checkout is a 408 MB download)
/AuraFace/

# Generated TRT engine files
*.engine
*.engine.*

# ONNX duplicates / runtime data files
yolo11s.onnx
yolo11s.onnx.data
yolov8n-face.onnx
yolov8n-face.onnx.data

# Root labels.txt — duplicate of already-committed perception/models/DeepStream-Yolo-Face/labels.txt
labels.txt
# ...except the class lists next to the client's deployed detectors (the nvinfer configs name them)
!products/el-mohandes/models/*/labels.txt

# Compiled parser artifacts (built by Dockerfile at image-build time)
*.so
*.o

# Logs
data/*.json
data/*.jpg
data/benchmark_sidecar_*.log
data/analysis_calls/

# Uploaded and sample videos (replay cameras, manual tests, benchmarks). They
# stay on each machine and, later, on the team SharePoint -- never in git:
# MR !25 review, 2026-10-01. Note this rule only stops NEW files; videos that
# were already tracked had to be removed with `git rm --cached`.
# Only the .dvc pointers of the sample videos are tracked (docs/DATA.md); files a user uploads in the UI stay untracked.
data/uploads/**
!data/uploads/**/
!data/uploads/**/*.dvc

# Recorded segments (runtime data)
data/segments/
data/clips/
data/proximity-review/
data/alert_clips/

# Benchmark results
benchmark/

# Extra repo docs / plans
EMBEDDING_SEARCH_PLAN.md

