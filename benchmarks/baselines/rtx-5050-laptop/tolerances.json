  {
   "match": "runtime.*.res.cgroup_peak_mib",
   "gate": false,
   "why": "the cgroup peak includes page cache and varies by hundreds of MiB between identical runs; anon memory (rss_anon_mib) is the gated memory metric"
  },
  {
   "match": "runtime.*.cpu_stage.*.busy",
