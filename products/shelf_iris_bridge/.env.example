# Shelf -> iris-platform bridge settings (copy to .env, which git ignores; fill in AMQP_URL). No secrets in this file.
# The broker user is the one iris-platform's operator created for this AI backend and listed in its
# AI_PUBLISHER_USERS (iris-platform docs/ai-integration.md §3.2). Use amqps:// in production.
AMQP_URL=amqp://<user>:<password>@<iris-rabbitmq-host>:5672/iris
# AMQP_USER=                      # default: the user in AMQP_URL
TARGET=cloud
# AMQP_QUEUE=                     # default ai.cloud.inbound (cloud) / edge.<slug>.inbound
# false when another cloud AI backend publishes the catalog (a snapshot replaces the whole cloud catalog)
PUBLISH_CATALOG=true
CONFIDENCE_MODE=stability
# REDIS_URL, MAPPING_FILE, SIDECAR_CONFIG and IRIS_SIDECAR_ROLE are set by docker-compose.shelf-live.yml (the stack's
# `redis`; SHELF_IRIS_MAPPING mounted at /config/shelf-iris-mapping.yaml; SIDECAR_CONFIG and IRIS_SIDECAR_ROLE from
# your shell, the same values the sidecar gets: its role_scoped_keys and role name the alert streams). Under compose
# the lines below are ignored. Set them here only when running `python -m shelf_iris_bridge` by hand (from the repo
# root, so `perception` imports).
# SIDECAR_CONFIG=configs/presets/shelf/<preset>.yaml   # required: the sidecar's own preset, e.g. live-test.yaml
# IRIS_SIDECAR_ROLE=<role>                             # only if the sidecar gets its role from the environment
CONSUMER_GROUP=shelf-iris-bridge
